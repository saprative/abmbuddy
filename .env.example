# ABMBuddy reads configuration from `abmbuddy config` and stores secrets in your
# OS keychain. Environment variables are optional and mainly useful for CI or
# scripted runs — when set, they take precedence over stored configuration.
#
# Nothing here is required to run `npx abmbuddy` interactively.

# ---------------------------------------------------------------- AI provider
# openai | anthropic | google | openai-compatible
ABMBUDDY_LLM_PROVIDER=
ABMBUDDY_LLM_MODEL=
ABMBUDDY_LLM_BASE_URL=
# Used for whichever provider is selected. Provider-native variables
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY) also work.
ABMBUDDY_LLM_API_KEY=

# --------------------------------------------------------------- Web search
# tavily | brave | serper | duckduckgo | none
ABMBUDDY_SEARCH_PROVIDER=
ABMBUDDY_SEARCH_API_KEY=

# ------------------------------------------------------------------- HubSpot
# A service key (recommended) or private app access token. Either one skips
# `abmbuddy login hubspot` entirely. Create a service key under
# HubSpot -> Development -> Keys -> Service keys.
HUBSPOT_ACCESS_TOKEN=

# ----------------------------------------------------------------- Behaviour
# SEC EDGAR requires a User-Agent containing a contact address and rejects
# requests without one. `abmbuddy config` can store this instead.
ABMBUDDY_SEC_USER_AGENT=
# Where config.json and (if there is no keychain) credentials.json live.
ABMBUDDY_CONFIG_DIR=
# Never use the OS keychain, even when one is available.
ABMBUDDY_DISABLE_KEYCHAIN=
# Politeness: minimum gap between requests to the same host, in milliseconds.
ABMBUDDY_HOST_GAP_MS=
# Lifetime of the temporary HTTP cache, in milliseconds.
ABMBUDDY_CACHE_TTL_MS=
# Overrides the User-Agent sent to everything except SEC EDGAR.
ABMBUDDY_USER_AGENT=
